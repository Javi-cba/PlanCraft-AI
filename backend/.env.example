# --- Database (Neon / Postgres) ---
# Must use the psycopg v3 driver.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/plancraft

# --- LLM
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=https://ai-gateway.vercel.sh
AI_MODEL=anthropic/claude-sonnet-5

# Allowance before the AI endpoints answer 429 (per process; see lib/rate_limit.py).
AI_USER_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_MINUTE=30

# --- Clerk (auth) ---
# Dashboard -> API keys / JWKS endpoint.
CLERK_JWKS_URL=https://<tu-subdominio>.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=
# Recomendado: issuer esperado del token.
CLERK_ISSUER=https://<tu-subdominio>.clerk.accounts.dev
# Opcional: origins permitidos en el claim `azp`. Por defecto usa CORS_ORIGINS.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# --- CORS ---
# Comma-separated exact origins (scheme + host + port, no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Optional regex for dynamic origins, e.g. Vercel previews:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Must be false if CORS_ORIGINS is "*".
CORS_ALLOW_CREDENTIALS=true

# --- App ---
DEBUG=false
